{
  "name": "mailmeow",
  "version": "0.1.0",
  "description": "Send email with mailmeow. Same call shape as Resend, with auto idempotency and safe retries.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "generate": "bash scripts/generate-types.sh",
    "test": "vitest run --config vitest.config.ts",
    "test:contract": "bash scripts/contract-env.sh",
    "check": "bun run typecheck && bun run build && bun run test"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "openapi-typescript": "7.13.0",
    "resend": "6.38.1",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
